# ====================================================================
# Ontogram — Environment Configuration (example)
# Based on Cognee core.
#
# Usage:
#   cp .env.example .env
#   # then fill in LLM_API_KEY and adjust the model/endpoint
#
# Variables keep their COGNEE_* prefix because they are read by the Cognee
# core and by Ontogram's own scripts. Do not commit your real .env — it
# contains credentials.
# ====================================================================

# --- LLM Provider Settings (OpenAI-compatible LiteLLM Gateway) -------
# Use LLM_PROVIDER="openai" for ANY OpenAI-compatible base URL, including
# self-hosted LiteLLM proxies. Prefix the model with "openai/" in that case
# or LiteLLM errors with "LLM Provider NOT provided".
LLM_PROVIDER="openai"
LLM_MODEL="openai/Qwen/Qwen3.6-35B-A3B-FP8"
LLM_API_KEY="sk-replace-me"

# Custom LiteLLM Proxy / Base URL Endpoint. Leave empty ("") when talking
# directly to OpenAI/Anthropic so the SDK uses its own default host.
LLM_ENDPOINT="https://some-llm-provider-url/v1"

# --- Embedding Provider Settings -------------------------------------
# fastembed runs locally on CPU: no API key, no cost, no rate limits.
EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_ENDPOINT=""
# For cloud embeddings instead, e.g.:
#   EMBEDDING_PROVIDER="openai"
#   EMBEDDING_MODEL="text-embedding-3-small"
#   EMBEDDING_API_KEY="sk-..."

# --- Service & Network Ports (uncommon 94xx range) -------------------
# 9480 = REST API daemon (also serves /docs and /api/v1/visualize)
# 9481 = Ontogram MCP bridge (streamable-HTTP at /mcp)
# There is no frontend port: the web dashboard was removed, and the graph
# visualizer is an endpoint on the daemon.
COGNEE_BACKEND_PORT=9480
COGNEE_MCP_PORT=9481

# MCP transport: http (default, recommended) | sse | stdio
COGNEE_MCP_TRANSPORT=http

# REST daemon base URL the MCP bridge proxies to. Only override when the
# daemon runs on another host or port.
COGNEE_API_URL=http://localhost:9480

# --- Storage locations -----------------------------------------------
# IMPORTANT: Cognee core defaults these to paths INSIDE its own installed
# package directory. Under Docker that is the image layer, so leaving them
# unset means every `docker compose up --build` silently wipes all memory.
#
# Docker: docker-compose.yml already sets all three to /root/.cognee/*,
# backed by the named volume `cognee_data`. Nothing to do here.
#
# Local (./start_services.py): uncomment and set ABSOLUTE paths outside the
# venv. This file is parsed literally, so $HOME / ${HOME} will NOT expand —
# write the full path out.
# DATA_ROOT_DIRECTORY=/absolute/path/to/ontogram-storage/data_storage
# SYSTEM_ROOT_DIRECTORY=/absolute/path/to/ontogram-storage/cognee_system
# CACHE_ROOT_DIRECTORY=/absolute/path/to/ontogram-storage/cache

# --- Cognee System Options -------------------------------------------
# false = single-tenant mode; all requests resolve to the default user.
# Read at import time, so it must be set before Cognee is imported.
ENABLE_BACKEND_ACCESS_CONTROL=false
CACHING=true
COGNEE_SKIP_CONNECTION_TEST=true
